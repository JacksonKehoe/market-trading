# Copy this file to `.env` and fill in the values you want to override.
# Every value below has a safe default in app/config/settings.py, so a
# missing .env file (or missing individual keys) will NOT crash the app.

# --- Paper trading account -------------------------------------------------
INITIAL_CAPITAL=100000
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,SPY,QQQ

# --- Filesystem locations ---------------------------------------------------
DATABASE_PATH=database/trading_bot.db
LOGS_DIR=logs
REPORTS_DIR=reports
CACHE_DIR=database/cache
# How long a fetched "latest price" is reused before refetching, in seconds.
LATEST_PRICE_CACHE_TTL_SECONDS=60.0

# --- Email reports (optional — leave blank to disable emailing) ------------
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Scheduler ---------------------------------------------------------------
MORNING_REPORT_TIME=08:00
EVENING_REPORT_TIME=17:30
HOURLY_SCAN_ENABLED=false

# --- Risk management defaults ------------------------------------------------
MAX_POSITION_SIZE_PCT=0.10
MAX_PORTFOLIO_ALLOCATION_PCT=1.0
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.03
MAX_OPEN_POSITIONS=10

# --- Simulated trading costs --------------------------------------------------
# Flat $ commission the PaperBroker deducts per simulated trade. 0 = free.
COMMISSION_PER_TRADE=0.0

# --- Live/scheduled paper trading ---------------------------------------------
# Which strategies the scheduler and dashboard run: any comma-separated
# subset of sma | rsi | macd | sma_sentiment. Each gets its own independent
# simulated account (same starting capital, same watchlist) so results are
# directly comparable side by side in the dashboard and email reports.
# sma_sentiment scrapes news headlines and vetoes SMA-crossover BUY signals
# when sentiment is bearish -- add it to compare against plain "sma".
STRATEGIES=sma,rsi,macd

# --- News sentiment (free/local: scraped headlines + VADER, no API key) ------
# How many recent headlines to fetch and score per symbol.
SENTIMENT_HEADLINE_LIMIT=10
# How long a computed sentiment score is reused before rescraping, in seconds.
SENTIMENT_CACHE_TTL_SECONDS=1800.0

# --- Benchmark comparison -----------------------------------------------------
# Symbol tracked alongside every strategy (dashboard chart/table, evening
# email comparison row, morning email day-change) so performance can be
# measured against a passive baseline.
BENCHMARK_SYMBOL=SPY
