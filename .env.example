# Copy this file to `.env` and fill in the values you want to override.
# Every value below has a safe default in app/config/settings.py, so a
# missing .env file (or missing individual keys) will NOT crash the app.

# --- Paper trading account -------------------------------------------------
INITIAL_CAPITAL=100000
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,SPY,QQQ

# --- Filesystem locations ---------------------------------------------------
DATABASE_PATH=database/trading_bot.db
LOGS_DIR=logs
REPORTS_DIR=reports
CACHE_DIR=database/cache
# How long a fetched "latest price" is reused before refetching, in seconds.
LATEST_PRICE_CACHE_TTL_SECONDS=60.0

# --- Email reports (optional — leave blank to disable emailing) ------------
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Scheduler ---------------------------------------------------------------
MORNING_REPORT_TIME=08:00
EVENING_REPORT_TIME=17:30
HOURLY_SCAN_ENABLED=false

# --- Risk management defaults ------------------------------------------------
MAX_POSITION_SIZE_PCT=0.10
MAX_PORTFOLIO_ALLOCATION_PCT=1.0
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.03
MAX_OPEN_POSITIONS=10

# --- Simulated trading costs --------------------------------------------------
# Flat $ commission the PaperBroker deducts per simulated trade. 0 = free.
COMMISSION_PER_TRADE=0.0

# --- Live/scheduled paper trading ---------------------------------------------
# Which strategy the scheduler and dashboard use: sma | rsi | macd
STRATEGY=sma
